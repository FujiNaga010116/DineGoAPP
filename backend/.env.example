# ==============================================================================
# DineGo Backend Environment Configuration (Group 17)
# Copy this file to .env and fill in all REQUIRED values before running.
# Provider: Microsoft SQL Server Express
# ==============================================================================

# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ==============================================================================
# REQUIRED — Application will refuse to start without these values
# ==============================================================================

# Database (SQL Server Express + Prisma ORM) — REQUIRED
# Option 1: Windows Authentication (recommended for local dev)
DATABASE_URL=sqlserver://localhost\SQLEXPRESS;database=dinego_db;integratedSecurity=true;trustServerCertificate=true

# Option 2: SQL Server Authentication (if using sa account or custom user)
# DATABASE_URL=sqlserver://localhost\SQLEXPRESS;database=dinego_db;user=sa;password=YourPassword;trustServerCertificate=true

# JWT Secrets — REQUIRED, minimum 32 characters each
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_STRING_MINIMUM_32_CHARACTERS_LONG
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_STRING_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# Phase 6 - Payment Gateway Sandbox
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=

# Phase 8 - Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Phase 9 - AI Culinary Guide
# GEMINI_API_KEY=
