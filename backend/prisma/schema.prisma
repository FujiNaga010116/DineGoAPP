// ==============================================================================
// DineGo Backend Prisma Schema (Group 17)
// Phase 2: Database Schema & Prisma Core (Identity, RBAC, Merchant & Menu)
// Provider: Microsoft SQL Server Express
// Note: SQL Server does not support native enums.
//       Enum values are stored as NVARCHAR with CHECK constraints in migration SQL.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// MODULE 1: ACCOUNT & RBAC (Thành - Identity & Catalog)
// ------------------------------------------------------------------------------

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  fullName        String   @map("full_name")
  phoneNumber     String?  @unique @map("phone_number")
  avatarUrl       String?  @map("avatar_url")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relationships
  roles           UserRole[]
  merchants       Merchant[]
  sessions        UserSession[]
  cart            Cart?
  promotionUsages PromotionUsage[]
  orders          Order[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  // Role values: CUSTOMER | MERCHANT | DRIVER | ADMIN
  role      String   @default("CUSTOMER") @db.NVarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@map("user_sessions")
}

// ------------------------------------------------------------------------------
// MODULE 2: MERCHANT & MENU (Thành - Identity & Catalog)
// ------------------------------------------------------------------------------

model Merchant {
  id           String   @id @default(uuid())
  ownerId      String   @map("owner_id")
  name         String
  slug         String   @unique
  description  String?  @db.NVarChar(Max)
  address      String
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  phoneNumber  String   @map("phone_number")
  logoUrl      String?  @map("logo_url")
  coverUrl     String?  @map("cover_url")
  // MerchantStatus values: PENDING | APPROVED | REJECTED | SUSPENDED
  status       String   @default("PENDING") @db.NVarChar(50)
  // DeliveryType values: MERCHANT_SELF | DINEGO_SHIPPER | BOTH
  deliveryType String   @default("DINEGO_SHIPPER") @map("delivery_type") @db.NVarChar(50)
  isOpen       Boolean  @default(true) @map("is_open")
  isActive     Boolean  @default(true) @map("is_active")
  openingTime  String?  @map("opening_time")
  closingTime  String?  @map("closing_time")
  rating       Decimal  @default(0.0) @db.Decimal(3, 2)
  totalReviews Int      @default(0) @map("total_reviews")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  // SQL Server requires NoAction on self-referencing or multi-path cascade chains
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories Category[]
  menuItems  MenuItem[]
  toppings   Topping[]
  carts      Cart[]
  promotions Promotion[]
  orders     Order[]

  @@index([ownerId])
  @@index([status, isActive])
  @@index([slug])
  @@map("merchants")
}

model Category {
  id           String   @id @default(uuid())
  merchantId   String   @map("merchant_id")
  name         String
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  merchant  Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@index([merchantId, displayOrder])
  @@index([merchantId, isActive])
  @@map("categories")
}

model MenuItem {
  id           String   @id @default(uuid())
  merchantId   String   @map("merchant_id")
  categoryId   String   @map("category_id")
  name         String
  slug         String
  description  String?  @db.NVarChar(Max)
  imageUrl     String?  @map("image_url")
  basePrice    Decimal  @map("base_price") @db.Decimal(12, 2)
  isAvailable  Boolean  @default(true) @map("is_available")
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // NoAction to break multi-path cascade: Merchant -> Category -> MenuItem
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  menuItemToppings MenuItemTopping[]
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@index([merchantId, isActive, isAvailable])
  @@index([categoryId, displayOrder])
  @@map("menu_items")
}

model Topping {
  id          String   @id @default(uuid())
  merchantId  String   @map("merchant_id")
  name        String
  price       Decimal  @db.Decimal(12, 2)
  isAvailable Boolean  @default(true) @map("is_available")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  menuItemToppings  MenuItemTopping[]
  cartItemToppings  CartItemTopping[]
  orderItemToppings OrderItemTopping[]

  @@index([merchantId, isActive])
  @@map("toppings")
}

model MenuItemTopping {
  id         String   @id @default(uuid())
  menuItemId String   @map("menu_item_id")
  toppingId  String   @map("topping_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relationships
  // NoAction to break multi-path cascade: Merchant -> MenuItem -> MenuItemTopping
  //                                   and Merchant -> Topping  -> MenuItemTopping
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topping  Topping  @relation(fields: [toppingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([menuItemId, toppingId])
  @@index([menuItemId])
  @@index([toppingId])
  @@map("menu_item_toppings")
}

// ------------------------------------------------------------------------------
// MODULE 3: CART ENGINE (Phase 5.1 - SQL Server Compatible)
// ------------------------------------------------------------------------------

model Cart {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  merchantId String?  @map("merchant_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relationships
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction to prevent multiple cascade paths in SQL Server
  merchant Merchant?  @relation(fields: [merchantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items    CartItem[]

  @@index([userId])
  @@index([merchantId])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String   @map("cart_id")
  menuItemId String   @map("menu_item_id")
  quantity   Int      @default(1)
  note       String?  @db.NVarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relationships
  cart     Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  // NoAction to prevent multiple cascade paths in SQL Server (User -> Cart -> CartItem vs User -> Merchant -> MenuItem -> CartItem)
  menuItem MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toppings CartItemTopping[]

  @@index([cartId])
  @@index([menuItemId])
  @@map("cart_items")
}

model CartItemTopping {
  id         String   @id @default(uuid())
  cartItemId String   @map("cart_item_id")
  toppingId  String   @map("topping_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relationships
  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  // NoAction to prevent multiple cascade paths in SQL Server
  topping  Topping  @relation(fields: [toppingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cartItemId, toppingId])
  @@index([cartItemId])
  @@index([toppingId])
  @@map("cart_item_toppings")
}

// ------------------------------------------------------------------------------
// MODULE 4: PROMOTION ENGINE (Phase 5.2 - SQL Server Compatible)
// ------------------------------------------------------------------------------

model Promotion {
  id                String    @id @default(uuid())
  code              String    @unique @db.NVarChar(50)
  name              String    @db.NVarChar(200)
  description       String?   @db.NVarChar(1000)
  // DiscountType: PERCENTAGE | FIXED_AMOUNT
  discountType      String    @map("discount_type") @db.NVarChar(50)
  discountValue     Decimal   @map("discount_value") @db.Decimal(12, 2)
  minOrderValue     Decimal   @default(0.00) @map("min_order_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?  @map("max_discount_amount") @db.Decimal(12, 2)
  startDate         DateTime  @map("start_date")
  endDate           DateTime  @map("end_date")
  maxUsage          Int?      @map("max_usage")
  currentUsage      Int       @default(0) @map("current_usage")
  maxUsagePerUser   Int?      @default(1) @map("max_usage_per_user")
  // Scope: GLOBAL | MERCHANT
  scope             String    @default("GLOBAL") @db.NVarChar(50)
  merchantId        String?   @map("merchant_id")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relationships
  // NoAction to prevent multiple cascade paths in SQL Server
  merchant   Merchant?        @relation(fields: [merchantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userUsages PromotionUsage[]
  orders     Order[]

  @@index([code])
  @@index([merchantId, isActive])
  @@index([startDate, endDate, isActive])
  @@map("promotions")
}

model PromotionUsage {
  id             String   @id @default(uuid())
  promotionId    String   @map("promotion_id")
  userId         String   @map("user_id")
  orderId        String?  @map("order_id")
  discountAmount Decimal? @map("discount_amount") @db.Decimal(12, 2)
  usedAt         DateTime @default(now()) @map("used_at")

  // Relationships
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  // NoAction to prevent multiple cascade paths in SQL Server (User -> Merchant -> Promotion -> PromotionUsage vs User -> PromotionUsage)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([promotionId, userId])
  @@index([userId])
  @@index([orderId])
  @@map("promotion_usages")
}

// ------------------------------------------------------------------------------
// MODULE 5: ORDER ENGINE (Phase 5.3 - SQL Server Compatible)
// ------------------------------------------------------------------------------

model Order {
  id              String    @id @default(uuid())
  orderNumber     String    @unique @map("order_number") @db.NVarChar(50)
  userId          String    @map("user_id")
  merchantId      String    @map("merchant_id")
  promotionId     String?   @map("promotion_id")
  // OrderStatus: PENDING | CONFIRMED | PREPARING | READY_FOR_PICKUP | COMPLETED | CANCELLED
  status          String    @default("PENDING") @db.NVarChar(50)
  subtotal        Decimal   @db.Decimal(12, 2)
  discountAmount  Decimal   @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  deliveryFee     Decimal   @default(0.00) @map("delivery_fee") @db.Decimal(12, 2)
  finalTotal      Decimal   @map("final_total") @db.Decimal(12, 2)
  deliveryAddress   String         @map("delivery_address") @db.NVarChar(500)
  deliveryLatitude  Float?         @map("delivery_latitude")
  deliveryLongitude Float?         @map("delivery_longitude")
  recipientName     String         @map("recipient_name") @db.NVarChar(200)
  recipientPhone    String         @map("recipient_phone") @db.NVarChar(20)
  orderTracking     OrderTracking?
  customerNote    String?   @map("customer_note") @db.NVarChar(500)
  cancelReason    String?   @map("cancel_reason") @db.NVarChar(500)
  cancelledBy     String?   @map("cancelled_by") @db.NVarChar(50)
  cancelledAt     DateTime? @map("cancelled_at")
  idempotencyKey  String?   @unique @map("idempotency_key") @db.NVarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relationships
  // Use NoAction to prevent multiple cascade paths in SQL Server
  user            User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotion       Promotion?       @relation(fields: [promotionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items           OrderItem[]
  promotionUsages PromotionUsage[]
  payment         Payment?

  @@index([userId, createdAt])
  @@index([merchantId, status])
  @@index([orderNumber])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  menuItemId String?  @map("menu_item_id")
  itemName   String   @map("item_name") @db.NVarChar(200)
  itemImage  String?  @map("item_image") @db.NVarChar(1000)
  basePrice  Decimal  @map("base_price") @db.Decimal(12, 2)
  quantity   Int      @default(1)
  subtotal   Decimal  @db.Decimal(12, 2)
  note       String?  @db.NVarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relationships
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?          @relation(fields: [menuItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toppings   OrderItemTopping[]

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderItemTopping {
  id           String   @id @default(uuid())
  orderItemId  String   @map("order_item_id")
  toppingId    String?  @map("topping_id")
  toppingName  String   @map("topping_name") @db.NVarChar(200)
  toppingPrice Decimal  @map("topping_price") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  // Relationships
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  topping      Topping?  @relation(fields: [toppingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderItemId])
  @@index([toppingId])
  @@map("order_item_toppings")
}

// ------------------------------------------------------------------------------
// MODULE 6: PAYMENT ENGINE (Phase 6 - MoMo All-in-One Gateway)
// ------------------------------------------------------------------------------

model Payment {
  id             String    @id @default(uuid())
  orderId        String    @unique @map("order_id")
  paymentMethod  String    @default("MOMO_QR") @map("payment_method") @db.NVarChar(50)
  paymentStatus  String    @default("PENDING") @map("payment_status") @db.NVarChar(50)
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("VND") @db.NVarChar(10)
  transactionRef String?   @unique @map("transaction_ref") @db.NVarChar(100)
  requestId      String    @unique @map("request_id") @db.NVarChar(100)
  idempotencyKey String?   @unique @map("idempotency_key") @db.NVarChar(100)
  paidAt         DateTime? @map("paid_at")
  gatewayPayload String?   @map("gateway_payload") @db.NVarChar(Max)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relationships
  // Use NoAction to prevent multiple cascade paths in SQL Server
  order          Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
  @@index([transactionRef])
  @@index([paymentStatus])
  @@map("payments")
}

// ------------------------------------------------------------------------------
// MODULE 7: LIVE DELIVERY TRACKING (Driver & Customer Real-Time Map)
// ------------------------------------------------------------------------------

model OrderTracking {
  id                String    @id @default(uuid())
  orderId           String    @unique @map("order_id")
  driverId          String?   @map("driver_id")
  driverName        String?   @map("driver_name") @db.NVarChar(200)
  driverPhone       String?   @map("driver_phone") @db.NVarChar(20)
  vehiclePlate      String?   @map("vehicle_plate") @db.NVarChar(50)
  driverRating      Float?    @default(4.9) @map("driver_rating")
  deliveryStatus    String    @default("WAITING_DRIVER") @map("delivery_status") @db.NVarChar(50)
  storeLatitude     Float     @map("store_latitude")
  storeLongitude    Float     @map("store_longitude")
  customerLatitude  Float     @map("customer_latitude")
  customerLongitude Float     @map("customer_longitude")
  shipperLatitude   Float?    @map("shipper_latitude")
  shipperLongitude  Float?    @map("shipper_longitude")
  heading           Float?
  distanceKm        Float     @default(0) @map("distance_km")
  etaMinutes        Int       @default(0) @map("eta_minutes")
  lastLocationAt    DateTime? @map("last_location_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Use NoAction to prevent multiple cascade paths in SQL Server
  order Order @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([driverId])
  @@index([deliveryStatus])
  @@map("order_trackings")
}


