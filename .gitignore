# ==============================================================================
# DineGo Application — Root .gitignore (Group 17)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/

# Environment configurations (Keep examples only)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Unignore example env files
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# TypeScript build cache
*.tsbuildinfo
tsconfig.build.tsbuildinfo

# Testing coverage
coverage/
.vitest/

# Vite cache
.vite/

# Runtime persisted state
.data/
backend/.data/

